@ARTICLE{Husain2026175,
	author = {Husain, Waqar and Jahrami, Haitham and Trabelsi, Khaled and Ammar, Achraf and Ijaz, Farrukh and Husain, Muhammad Ahmad and Jawad, Aatiqa and Iqbal, Angbeen and Kashaf-A-Duja},
	title = {From traits to character: Development and validation of the Personality and Character Scale.},
	year = {2026},
	journal = {Humanistic Psychologist},
	volume = {54},
	number = {2},
	pages = {175 - 215},
	doi = {10.1037/hum0000395},
	url = {https://www.scopus.com/pages/publications/105051960727?origin=resultslist},
	abstract = {Modern definitions of personality adopt a comprehensive approach, emphasizing both overt behaviors and overlooked internal qualities that form one’s character. The objective of the current research was to develop and validate the Personality and Character Scale (P & C Scale) to align with the framework of psychosocial health, which redefines mental health to include sexual, emotional, social, environmental, cognitive, religious, moral, and spiritual satisfaction. The study involved 1,846 participants (Mage = 27 years; women = 55%). The P & C Scale demonstrated high reliability across three consecutive studies (α = .933, .957, and .976). Exploratory factor analysis revealed an 11-factor structure consisting of 42 items. Confirmatory factor analysis confirmed this structure, showing good fit indices (comparative fit index = .915, Tucker–Lewis index = .904, root-mean-square error of approximation = .064). The scale’s convergent validity was established through a significant positive correlation with the Big Five Personality Inventory (r = .481, p < .01). Based on a higher order factor analysis, a two-structured solution was also presented which included personality and character as two subscales of the P & C Scale. The P & C Scale is a significant advancement in the field of personality psychology by highlighting the combination of personality and character, within the framework of psychosocial health. (PsycInfo Database Record (c) 2026 APA, all rights reserved) The Personality and Character Scale offers a more comprehensive measure of personality by including internal qualities that shape character, such as justice, mercy, and spirituality. This scale aligns with a holistic model of psychosocial health, spanning emotional, social, moral, and spiritual well-being, and reflects both personality and character traits. The scale marks an advancement in personality assessment, providing insights that could enhance understanding and support of mental health in diverse settings. (PsycInfo Database Record (c) 2026 APA, all rights reserved) © 2025 American Psychological Association All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang2026468,
	author = {Wang, Liao and Jingrou, Deng and Tao, Li},
	title = {Influencing factors of urban drone delivery choice behavior in the context of the low-altitude economy; [低空经济下城市无人机配送选择行为影响因素研究]},
	year = {2026},
	journal = {Journal of Shenzhen University Science and Engineering},
	volume = {43},
	number = {4},
	pages = {468 - 476},
	doi = {10.3724/SP.J.1249.2026.04468},
	url = {https://www.scopus.com/pages/publications/105054131628?origin=resultslist},
	abstract = {Driven by the development of the low-altitude economy, drone delivery has emerged as a new driver for upgrading urban logistics systems. To investigate urban residents' preferences and decision-making mechanisms regarding drone delivery services, this study takes Shenzhen, China, as a case study. Based on random utility theory, revealed preferences (RP) and stated preferences (SP) surveys are conducted, and discrete choice models are employed to examine the effects of key factors on residents' actual choice behavior towards drone delivery services and the associated value conversion. The results show that residents exhibit risk-averse decision-making characteristics, and factors including safety, delivery cost, delivery time, and noise significantly influence the acceptance of drone delivery. Although variables such as gender, residential floor level, and residential location do not show significant main effects, their interaction effects with delivery cost and safety are significant, indicating that individual characteristics affect acceptance through interaction mechanisms. The effects of different factors vary substantially: safety and delivery cost have the greatest impacts on residents' choice behavior, followed by delivery time, while noise has the weakest effect. Furthermore, residents demonstrate different levels of sensitivity to these factors, with scenarios characterized by high safety and low delivery fees being the most attractive. Therefore, improving delivery safety and controlling delivery costs are essential for enhancing public acceptance of drone delivery, while differentiated strategies should be developed according to the distinct characteristics of different population groups. © 2026 Science Press. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Peng2026,
	author = {Peng, Yafeng and Zeng, Jinxin and Chen, Hui and Li, Yujun},
	title = {Validation and application of the Chinese version of the abbreviated math anxiety scale},
	year = {2026},
	journal = {Acta Psychologica},
	volume = {270},
	pages = {},
	doi = {10.1016/j.actpsy.2026.107961},
	url = {https://www.scopus.com/pages/publications/105052680688?origin=resultslist},
	abstract = {Background: Evidence on the psychometric performance of the Abbreviated Math Anxiety Scale (AMAS) and the heterogeneity of math anxiety among Chinese secondary-school students remains limited. This study evaluated the Chinese version of the AMAS (AMAS-C) and examined latent profiles of math anxiety and their associations with demographic and educational variables. Methods: Participants were 936 secondary-school students from Guangdong and Jiangxi, China. Internal consistency was assessed using Cronbach's alpha and McDonald's omega. Confirmatory factor analysis, external construct-validity analysis, and item response theory were used to evaluate the scale's measurement properties. Latent profile analysis was conducted on the nine AMAS items, followed by proportional-odds logistic regression. Results: The AMAS-C showed good internal consistency (α = 0.87; ω = 0.89), and its total score was negatively associated with mathematics attitudes (r = −0.57). The bifactor model provided the best fit in both the CFA and IRT comparisons. This model included a dominant general math-anxiety factor and two orthogonal context-specific factors representing residual variation associated with learning and evaluation situations. The test information function showed that the AMAS-C provided adequate measurement precision across a broad range of math-anxiety levels. LPA identified three quantitatively ordered profiles—Low Anxiety Across Both Contexts (24.6%), Intermediate Anxiety with Pronounced Evaluation Anxiety (50.0%), and High Anxiety Across Both Contexts (25.4%). These profiles differed in overall anxiety level and the relative prominence of learning and evaluation anxiety. Gender and mathematics performance were significantly associated with profile membership, whereas school stage, only-child status, and region were not. Female students had higher cumulative odds of belonging to a higher-anxiety profile than male students (OR = 1.70, 95% CI [1.32, 2.19]). Poorer mathematics performance was associated with lower predicted probabilities of first-profile membership and higher probabilities of third-profile membership. The predicted probability of second-profile membership peaked in intermediate performance categories. Conclusions: The AMAS-C demonstrated satisfactory reliability and validity evidence among Chinese secondary-school students. Among the candidate models examined, the bifactor model provided a reasonable working representation of the data, with a predominant general math anxiety factor. The IRT results indicated adequate item functioning and useful measurement precision across a range of math anxiety levels. The LPA identified three ordered profiles: Low Anxiety Across Both Contexts, Intermediate Anxiety with Pronounced Evaluation Anxiety, and High Anxiety Across Both Contexts. These profiles differed in overall anxiety level and the relative prominence of learning- and evaluation-related anxiety. Female students and students reporting poorer mathematics performance were more likely to belong to higher-anxiety profiles, whereas school stage, only-child status, and region showed no statistically significant independent associations with profile membership. © 2026 The Authors. Published by Elsevier B.V. This is an open access article under the CC BY license. http://creativecommons.org/licenses/by/4.0/},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Huang2026,
	author = {Huang, Zhefan and Wang, Kaidi and Lu, Bingjie and Wang, Mo and Hill, Aaron D. and Pryor, Christopher},
	title = {Leaving on a High or Low Note? An Achievement Goal Perspective on Executive Retirement},
	year = {2026},
	journal = {Personnel Psychology},
	pages = {},
	doi = {10.1111/peps.70047},
	url = {https://www.scopus.com/pages/publications/105054097697?origin=resultslist},
	abstract = {Executive retirement represents a pivotal career transition with significant implications. However, our understanding of the antecedents of executive retirement remains limited. We contend that, different from the retirement of general employees, it is important to position executive retirement within an achievement context and consider factors such as firm performance and achievement goal orientations. Drawing on late adulthood developmental psychology, we propose an achievement goal framework to theorize the relationship between firm performance and executive retirement, and the moderating roles of goal orientations. We theorize that firm performance is associated with two distinct mechanisms: the legacy fulfillment mechanism (salient for executives with high performance) and the selective prioritization mechanism (salient for executives with low performance), which together result in a U-shaped relationship between firm performance and the likelihood of executive retirement. We further consider executives’ goal orientations as boundary conditions to probe the underlying mechanisms. We found general support for our theory using an archival dataset of 1840 chief executive officers from S&P 1500 firms (Study 1) and a two-wave survey of 363 executives (Study 2). By integrating developmental psychology theories into the executive retirement literature, our research sheds light on executive retirement decisions through a developmental psychology lens. © 2026 The Author(s). Personnel Psychology published by Wiley Periodicals LLC.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Njøten20261,
	author = {Njøten, Håkon and Feyer, Frida K.},
	title = {From fragmentation to framework: defining core human competencies for higher education and the workplace},
	year = {2026},
	journal = {Higher Education, Skills and Work-based Learning},
	pages = {1 - 21},
	doi = {10.1108/HESWBL-03-2026-0201},
	url = {https://www.scopus.com/pages/publications/105053365576?origin=resultslist},
	abstract = {Purpose – This article addresses the lack of a coherent, shared language for human-centred competencies in higher education, introducing core human competencies (CHCs) and the 4S framework as an integrative alternative to fragmented terminology such as soft skills, transferable skills and 21st-century skills. Design/methodology/approach – A dual-strategy methodology was employed: a synthesis of leading international competency frameworks (CASEL, BESSI, CCR, OECD Learning Compass, 2030) combined with a structured bibliometric analysis of 880 Scopus-indexed publications (2009–2025), using VOSviewer keyword co-occurrence mapping across seven identified clusters. Findings – Fifteen core competencies were identified from frameworks and research clusters. These are organised into the 4S framework: Self-awareness, Self-leadership, Situational management and Social capacities, positioning CHCs as a holistic framework. Research limitations/implications – The framework is conceptual and requires psychometric validation, longitudinal testing and cross-cultural assessment. Future research should examine predictive validity, factor structure and applicability across disciplines and cultural contexts. Practical implications – The 4S framework offers higher education institutions a shared conceptual language for curriculum design, learning outcomes, pedagogy, staff development and institutional strategy. Originality/value – This article provides the first empirically informed synthesis producing a unified taxonomy of CHCs applicable across higher education contexts, reducing terminological redundancy and offering a practically useable developmental architecture. 2026 © Emerald Publishing Limited},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Fortuna20261,
	author = {Fortuna, Paweł},
	title = {Positive Cyberpsychology: Human Flourishing in a Digital Era},
	year = {2026},
	journal = {Positive Cyberpsychology: Human Flourishing in a Digital Era},
	pages = {1 - 260},
	doi = {10.1002/9781394399680},
	url = {https://www.scopus.com/pages/publications/105053477204?origin=resultslist},
	abstract = {Well-being supported by digital technologies, grounded in research-based frameworks Researchers and practitioners need systematic approaches to studying how technology enhances rather than diminishes human flourishing. Positive Cyberpsychology: Human Flourishing in a Digital Era introduces PCyb as a field examining factors and processes that support well-being in digital interactions. Paweł Fortuna, one of the pioneers in positive cyberpsychology with over 50 peer-reviewed publications, provides the first comprehensive English-language framework for this emerging field. The book integrates and systematizes empirical findings using the psychological models of flourishing across health, relationships, personal growth, education and work contexts. Structured around three guiding questions—Why is PCyb? What is PCyb? How is PCyb?—it traces the field’s disciplinary development, connects positive psychology with cyberpsychology into a coherent integrative framework. Theoretical insights are combined with empirically grounded examples for immediate research application. Readers will also find: A concrete research framework that outlines specific psychological investigations rather than general approaches to technology design In-depth analysis revealing strong connections between positive psychology, cyberpsychology, and design practices for well-being-oriented digital experiences Concepts, directions, and methods for studying digital strengths, digital well-being, positive technology interventions, and the upward dynamics of flourishing in digital contexts. Evidence-informed insights relevant to implementing flourishing-oriented solutions across diverse contexts spanning AI-driven systems, applications, social media platforms, immersive technologies and gaming. Theoretical foundations combined with actionable examples suitable for coursework in cyberpsychology, positive psychology, AI ethics, and design Researchers and students in psychology, cyberpsychology, AI, and digital humanities will find essential and integrative frameworks and a rich source of research directions for advancing well-being-focused technology studies. Technology designers, UX specialists, and educators developing courses in positive psychology or ethical AI will gain research-informed guidance for shaping digital experiences that genuinely support human flourishing. © 2027 by John Wiley & Sons, Inc.},
	type = {Book},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Hausfeld2026,
	author = {Hausfeld, Mary M. and Hampel, Vera and Bach, Leon J. and Menges, Jochen I.},
	title = {Putting assumptions to the test: A meta-analytic review of gender differences in emotional intelligence and specific emotion abilities.},
	year = {2026},
	journal = {Emotion},
	pages = {},
	doi = {10.1037/emo0001733},
	url = {https://www.scopus.com/pages/publications/105054719072?origin=resultslist},
	abstract = {Are women more emotionally intelligent than men? Emotional intelligence (EI) is often colloquially ascribed to women, yet the extant empirical literature yields inconclusive results and EI theories are largely oblivious to gender as an explanatory dimension. To re-evaluate the literature, test key moderators, and develop stronger theory on EI, we examine whether and to what extent gender differences manifest in EI through a meta-analytic review of 1,279 articles comprised of 1,428 samples containing 609,278 participants drawn from published and unpublished work until December 31, 2023. The results suggest gender differences in general EI such that women appear to have higher EI on average, as well as more nuanced gender differences across specific emotional abilities, including some where there may be no difference. Women's advantage is stronger for other- than self-focused emotional abilities and varies by measurement type, with smaller differences in subjective than in performance-based assessments. Additionally, we find that contextual moderators, including leadership position, male-dominated industry, data collection year, participant age, and geographical region, are associated with the presence, magnitude, and direction of gender differences, suggesting that gender differences in EI vary across contexts. Overall, these findings show that women hold advantages in many emotional abilities, but that gender differences in EI are contingent on the target of emotional abilities, measurement type, and context, informing future research and theory building. (PsycInfo Database Record (c) 2026 APA, all rights reserved) © 2026 American Psychological Association All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

@ARTICLE{Gaete2026,
	author = {Gaete, Jorge and Ríos, Natalia and Rojas-Barahona, Cristian A. and Salgado, Gabriel and Ramírez, Saray and Araya, Ricardo},
	title = {Japi 2.0, a gaming platform to stimulate cognitive and socio-emotional skills in early childhood: results of a pilot randomized controlled trial},
	year = {2026},
	journal = {Child and Adolescent Psychiatry and Mental Health},
	volume = {20},
	number = {1},
	pages = {},
	doi = {10.1186/s13034-026-01133-1},
	url = {https://www.scopus.com/pages/publications/105053796889?origin=resultslist},
	abstract = {Background: Early childhood is a sensitive developmental period for the acquisition of cognitive and socio-emotional skills that are strongly associated with later mental health, academic achievement, and social functioning. Children growing up in socioeconomically disadvantaged contexts are at increased risk for early emotional and behavioral difficulties, highlighting the need for accessible, scalable, and developmentally appropriate preventive interventions. Japi 2.0 is a tablet-based gaming platform designed to stimulate six interrelated cognitive and socio-emotional skills—working memory, inhibitory control, emotion recognition, social competence, empathy, and cognitive planning—through structured play in preschool settings. Methods: We conducted a pilot cluster randomized controlled trial in low-income preschools in Santiago, Chile. Schools were randomized to either the Japi 2.0 intervention or treatment as usual. The intervention consisted of 24 individual sessions delivered over 12 weeks during regular class hours. Primary outcomes were acceptability (perceived by children, early years educators, and parents) and feasibility (recruitment, retention, attendance, intervention delivery, and data completeness). Secondary outcomes explored preliminary changes in cognitive, socio-emotional, and behavioral functioning using standardized assessments and parent- and teacher-reported measures. Exploratory analyses were conducted using multilevel models adjusted for baseline scores and clustering, based on available outcome data from randomized participants. Results: Japi 2.0 showed high acceptability across stakeholders. Educators and parents reported that the game and the accompanying web-based dashboard were engaging, age-appropriate, easy to use, and pedagogically relevant. Children reported high levels of enjoyment and positive emotional experiences during gameplay. Feasibility indicators were satisfactory: most planned sessions were delivered as scheduled, attendance was high, and outcome data completeness was adequate. Exploratory analyses indicated improvements over time in both groups across most outcomes. Preliminary exploratory signals favoring the intervention were observed for empathy and parent-reported emotional and behavioral difficulties; however, these findings should be interpreted cautiously given the small number of clusters and exploratory nature of the analyses. Conclusions: This pilot trial demonstrates that Japi 2.0 is a feasible and highly acceptable digital intervention for preschool children in low-income educational settings. Although efficacy findings are preliminary, results support progression to a fully powered randomized controlled trial to evaluate effectiveness and longer-term impacts on cognitive, socio-emotional, and behavioral development. Trial registration Clinical Trials NCT06420544, May 20th, 2024. https://www.clinicaltrials.gov/study/ NCT06420544. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{van den Hee2025,
	author = {van den Hee, Sarah M. and van Hooft, Edwin A. J. and Van Hoye, Greet and Nevicka, Barbara},
	title = {Unemployment in later life: The effects of a job search skills training intervention and development orientations on job search and reemployment of older job seekers.},
	year = {2025},
	journal = {Journal of Applied Psychology},
	pages = {},
	doi = {10.1037/apl0001323},
	url = {https://www.scopus.com/pages/publications/105053527017?origin=resultslist},
	abstract = {Late-career unemployment has a demonstrated negative impact on individuals and society. Yet little is known about the mechanisms through which policy programs operate to support older unemployed individuals in finding reemployment. The present study aimed to provide more insight into how a job search skills training program facilitates older job seekers in their reemployment process and who benefits most from the program. Using a two-group field experimental design among 4,625 unemployed job seekers aged over 50, we examined the effects of the job search skills training intervention on participants’ job search knowledge and self-efficacy, job search behaviors, and reemployment status and speed. In addition, the study examined whether the effects of job search skills training on job search knowledge and self-efficacy depend on older job seekers’ development orientations (i.e., future time perspective and learning goal orientation). Job search skills training was found to increase older job seekers’ job search knowledge and self-efficacy, and in turn their job search process quality, which then enhanced their chances and speed of finding reemployment. The positive effects of job search skills training on job search knowledge and self-efficacy appeared to be stronger for older job seekers with lower development orientations. The current findings advance training and job search theory by uncovering the explanatory mechanisms of a job search skills training program and by showing that individual attributes influence learning outcomes. Our findings also have important implications for the design, implementation, and evaluation of future policy programs aimed at older unemployed individuals and career counseling practice. (PsycInfo Database Record (c) 2025 APA, all rights reserved) © 2025 American Psychological Association},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access}
}

@ARTICLE{Li2026321,
	author = {Li, Xiaoyu and Bin Awang, Mohd Mahzan and Abdul Rahim, Syafiqah},
	title = {Family Socioeconomic Status, Student Activity Participation, and Socio-Emotional Skills: Evidence from Final-Year Undergraduates in Shandong, China},
	year = {2026},
	journal = {Asian Journal of Interdisciplinary Research},
	volume = {9},
	number = {3},
	pages = {321 - 334},
	doi = {10.54392/ajir26320},
	url = {https://www.scopus.com/pages/publications/105051643668?origin=resultslist},
	abstract = {This study examines the associations among family socioeconomic status (SES), student activity participation (SAP), and selected socio-emotional skill domains among final-year undergraduates, with SAP tested as a statistical mediator. Guided by Astin's I-E-O model and Bourdieu's capital theory, SAP is framed as an educational experience through which family background may be associated with differences in student development. Survey responses from 571 undergraduates at public universities in Shandong Province, China, were analyzed using SPSS 26 and AMOS 24. Structural equation modelling (SEM) was used to estimate the structural associations, and bootstrapping was used to test the indirect association through SAP. SES was positively associated with both SAP and socio-emotional skills, and SAP was positively associated with socio-emotional skills. The bootstrap analysis indicated a significant partial statistical mediation pattern. These findings suggest that family background remains associated with students' socio-emotional development in higher education and with access to student activity experiences. SAP may therefore represent one pathway through which SES-related differences are statistically linked to selected interpersonal and intrapersonal skill domains. Because the study is cross-sectional, the mediation results should be interpreted as associations rather than evidence of temporal or causal transmission. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Pfrombeck2026353,
	author = {Pfrombeck, Julian and Zaniboni, Sara and Grote, Gudela and Freund, Alexandra M and Heckhausen, Jutta and Truxillo, Donald M and Wang, Mo},
	title = {Uncertainty in work-related transitions over the life course},
	year = {2026},
	journal = {Work, Aging and Retirement},
	volume = {12},
	number = {4},
	pages = {353 - 370},
	doi = {10.1093/workar/waaf018},
	url = {https://www.scopus.com/pages/publications/105051798595?origin=resultslist},
	abstract = {Many aspects of one’s life are uncertain due to missing information about situations, probabilistic events, and decision outcomes. In this article, we argue and show that diverse perspectives from lifespan development as well as work and organizational psychology can be integrated into a fuller picture of individuals’ experiences of work-related transitions over the life course through the lens of uncertainty. Drawing from a panel discussion among several of the authors and the literature in aging, career, work, and retirement research, we develop an integrative conceptual framework that differentiates between exogenous and endogenous sources of uncertainty and highlights macro-, meso-, and micro-level sources of individuals’ experience of uncertainty as they navigate work-related transitions. Moreover, we discuss sources of uncertainty in perceptions, evaluations, and decisions during work-related transitions. Based on our framework, we propose a roadmap with recommendations for future research, which include (a) the conceptualization and operationalization of uncertainty based on perspectives common in aging, career, work, and retirement research, (b) the understanding of why and when aspects of uncertainty in work-related transitions can be challenges yet also provide new opportunities, and (c) organizational and policy measures that can help individuals successfully manage these uncertainties over the life course. © The Author(s) 2025. Published by Oxford University Press. This is an Open Access article distributed under the terms of the Creative Commons Attribution-NonCommercial License (https://creativecommons.org/licenses/by-nc/4.0/), which permits non-commercial re-use, distribution, and reproduction in any medium, provided the original work is properly cited. For commercial re-use, please contact reprints@oup.com for reprints and translation rights for reprints. All other permissions can be obtained through our RightsLink service via the Permissions link on the article page on our site—for further information please contact journals.permissions@oup.com.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Lievens2026,
	author = {Lievens, Filip and Zhou, You and Ng, Jomel Wei Xuan and Xi, Liyan and Tian, Yixin and Sackett, Paul R. and Martin-Raugh, Michelle},
	title = {A meta-analytic examination of the criterion-related validity and cognitive loading associated with traditional and new situational judgment test paradigms.},
	year = {2026},
