
@article{ WOS:001831688800001,
Author = {Rakhimbekova, Assel and Shora, Nurym and Yessingeldinov, Baurzhan and
   Shilibekova, Aidana},
Title = {Teachers' Socio-Emotional Competencies in the Digital Era:
   Cross-Cultural Adaptation and Psychometric Validation of the BESSI in
   Kazakhstan},
Journal = {EDUCATION SCIENCES},
Year = {2026},
Volume = {16},
Number = {7},
Month = {JUL 17},
Abstract = {Teachers' socio-emotional competencies are increasingly recognized as
   essential for professional well-being, adaptive teaching, and effective
   participation in digitally transforming educational systems. However,
   valid and culturally appropriate instruments for assessing these
   competencies among teachers remain limited, particularly in multilingual
   and underrepresented educational contexts. This study aimed to adapt the
   Behavioral, Emotional, and Social Skills Inventory (BESSI) for teachers
   in Kazakhstan and to examine its preliminary psychometric properties and
   socio-emotional competency profiles. The instrument was translated and
   culturally adapted into Kazakh and Russian using a TRAPD-based
   (Translation, Review, Adjudication, Pretesting, and Documentation)
   procedure involving translation, review, adjudication, pretesting, and
   documentation. Data were collected from 1458 school teachers across
   Kazakhstan representing different subject areas and language groups.
   After data-quality screening, the final analytic sample included 918
   valid observations. Reliability analyses demonstrated excellent
   total-scale internal consistency (Cronbach's alpha = 0.92; McDonald's
   omega = 0.94), while domain-level reliability ranged from moderate to
   acceptable (alpha = 0.60-0.76; omega = 0.73-0.81). Exploratory factor
   analysis suggested an empirical eight-factor structure rather than a
   direct replication of the original BESSI framework, indicating that
   socio-emotional competencies may be organized differently in teacher
   populations. Model-based clustering identified four exploratory teacher
   profiles reflecting different configurations of self-management,
   emotional regulation, interpersonal, and innovation-related
   competencies. The profiles differed not only in overall competency
   levels but also in specific patterns of strengths and developmental
   needs. The findings provide preliminary evidence supporting the use of
   the adapted BESSI as a promising research and diagnostic instrument for
   assessing teachers' socio-emotional competencies in Kazakhstan. At the
   same time, the results indicate the need for further confirmatory
   validation, measurement invariance testing, and external validity
   evidence before broader application.},
DOI = {10.3390/educsci16071148},
Article-Number = {1148},
EISSN = {2227-7102},
Unique-ID = {WOS:001831688800001},
}

@article{ WOS:001819203800001,
Author = {Springstein, Tabea and Bankston, Anna C. and English, Tammy},
Title = {To Regulate or Not to Regulate? Situational and Individual Differences
   in Emotion Regulation Initiation in Daily Life},
Journal = {PERSONALITY AND SOCIAL PSYCHOLOGY BULLETIN},
Year = {2026},
Month = {2026 JUL 13},
Abstract = {Situational and individual differences shape how and why people regulate
   emotions, but whether emotion regulation is initiated remains
   understudied. We hypothesize that, for example, less familiar situations
   might be associated with more regulation initiation, and people who
   believe emotions are controllable initiate regulation more frequently.
   Using experience sampling (N = 216; 7x/14 days), we found that
   participants initiated regulation 60\% of the time over the past 2 hr.
   As predicted, people initiated regulation in less familiar, less
   pleasant contexts, and with more dominant, less warm social partners.
   Unexpectedly, individuals who believe emotions are uncontrollable were
   more likely to initiate regulation, even after accounting for affect.
   These findings highlight that while attention has mostly focused on
   strategy selection or efficacy, meaningful situational and individual
   differences also exist at the emotion regulation initiation stage when
   individuals determine whether to expend regulatory resources to maintain
   well-being.},
DOI = {10.1177/01461672261461318},
EarlyAccessDate = {JUL 2026},
ISSN = {0146-1672},
EISSN = {1552-7433},
ResearcherID-Numbers = {Springstein, Tabea/HNI-0611-2023
   },
ORCID-Numbers = {Bankston, Anna/0009-0009-9394-6287
   Springstein, Tabea/0000-0003-4712-6543},
Unique-ID = {WOS:001819203800001},
}

@article{ WOS:001812712600001,
Author = {Feraco, Tommaso and Calderan, Margherita and Pellegrino, Gerardo},
Title = {The Living SEB Skills Project: A Living Resource for Review and
   Meta-Analysis of Social, Emotional, and Behavioral Skills},
Journal = {EUROPEAN JOURNAL OF PERSONALITY},
Year = {2026},
Month = {2026 JUL 6},
Abstract = {The social, emotional, and behavioral (SEB) skills framework was
   recently proposed as an integrative model for soft
   skills/socio-emotional competencies, clarifying their definition and
   distinction from personality traits. To support open and cumulative
   research in this area, we introduce the Living SEB Skills Project, a
   continuously updated database combining ongoing literature searches, an
   open repository of coded studies and effect sizes, and an interactive
   application enabling customizable meta-analyses. Using meta-analyses of
   correlations and meta-analytic structural equation models, we
   demonstrate the database's utility by testing the predictive and
   incremental validity of SEB skills for academic achievement on the
   current available data (364 publications, of which 30 met the criteria
   for the living review and 19 {[}26 samples] for the quantitative
   synthesis). The Living SEB Skills Project sets out as a transparent,
   dynamic and openly accessible tool to accelerate and ease cumulative
   science and synthesis within the SEB skills framework and beyond.},
DOI = {10.1177/08902070261467477},
EarlyAccessDate = {JUL 2026},
ISSN = {0890-2070},
EISSN = {1099-0984},
ResearcherID-Numbers = {Feraco, Tommaso/AAE-7945-2021
   Calderan, Margherita/MXL-6050-2025
   Pellegrino, Gerardo/KLC-9707-2024},
Unique-ID = {WOS:001812712600001},
}

@article{ WOS:001814583000010,
Author = {Scurtu-Tura, Claudiai and Gonzalez, Alfonso javier garcia},
Title = {Does the Educational System Teach Social Skills? A Before-and-After
   Analysis with Primary School Students},
Journal = {EDUCATIO SIGLO XXI},
Year = {2026},
Volume = {44},
Number = {2},
Pages = {223-244},
Month = {JUL-OCT},
Abstract = {During their studies, students engage not only in formal teaching
   processes but also in learning processes shaped by the interactions they
   establish with peers, teachers, and other actors within the academic
   community. Knowing how to communicate effectively affects career success
   and personal well-being, making social skills training (SST) programs a
   ``must have{''}. This study examines the implementation of a social
   skills training program within a university context. Over a four-month
   period, 82 pre-service teachers (90.2\% women and 9.8\% men), aged
   between 20 and 49 years (M = 22.33, SD = 3.48), participated in a
   longitudinal study designed to assess the effectiveness of the program.
   Social skills were addressed through participation in
   theoretical-practical classes on family, school, interpersonal
   relationships, and social change. The study followed a
   pre-test/post-test design aligned with the course teaching project. The
   post-test results revealed a significant overall improvement in social
   skills across all assessed factors. Initial differences associated with
   gender and age were reduced or eliminated following the intervention,
   suggesting that the program effectively enhanced students' social
   skills.},
DOI = {10.6018/educatio.635231},
ISSN = {1699-2105},
EISSN = {1989-466X},
ResearcherID-Numbers = {Garcia, Alfonso/KMX-7697-2024},
Unique-ID = {WOS:001814583000010},
}

@article{ WOS:001812832900001,
Author = {Allemand, Mathias and Olaru, Gabriel and Hill, Patrick L.},
Title = {Motivation to change personality across adulthood: Preferences for human
   and digital assistance in representative Swiss samples},
Journal = {PERSONALITY AND INDIVIDUAL DIFFERENCES},
Year = {2026},
Volume = {262},
Month = {NOV},
Abstract = {Despite growing interest in volitional personality change, evidence from
   representative, non-student samples remain scarce, limiting
   understanding of how motivation to change personality is distributed
   across adulthood and linked to preferences for support. The motivation
   to change personality varies across individuals and does not always
   translate into change attempts. Using two cross-sectional Swiss samples
   spanning adulthood (Sample 1: N = 1011; Sample 2: N = 1898) and a
   layperson-informed definition of personality, we examined the prevalence
   of motivational stages of personality change, demographic and
   psychological correlates, and preferences for human versus digital
   assistance. Most participants reported not considering personality
   change, whereas fewer reported planning or actively attempting change.
   Younger age and higher education were associated with greater motivation
   to change, particularly with active change attempts. Moreover, lower
   life satisfaction and higher adaptability were associated with being in
   planning or active stages. Most participants preferred human assistance
   or no assistance, whereas exclusively digital support was rare.
   Participants endorsing digital or combined approaches reported greater
   willingness to use and more frequent use of digital tools. Overall, the
   findings provide descriptive information on motivational stages of
   personality change, and suggest that, despite increasing technological
   availability, human support remains the dominant preference across
   adulthood.},
DOI = {10.1016/j.paid.2026.113970},
EarlyAccessDate = {JUN 2026},
Article-Number = {113970},
ISSN = {0191-8869},
EISSN = {1873-3549},
ResearcherID-Numbers = {Olaru, Gabriel/AAL-5282-2020},
Unique-ID = {WOS:001812832900001},
}

@article{ WOS:001806918400001,
Author = {Jaggy, Ann-Kathrin and Hopp, Manuel D. S. and Trautwein, Ulrich and
   Roberts, Brent W.},
Title = {Predicting Scientific and Artistic Creative Achievements in Adolescence:
   A Comprehensive Approach Integrating Personality, Motivation, and
   Cognitive Ability},
Journal = {EUROPEAN JOURNAL OF PERSONALITY},
Year = {2026},
Month = {2026 JUN 29},
Abstract = {Extensive knowledge about creative achievements and their association
   with personality traits, motivation, and cognitive ability has been
   derived from univariate studies in adult samples. In contrast, research
   on children's talent development often focuses narrowly on academic
   performance, overlooking creative achievements as developmental
   milestones. To better understand the nomological net of childhood
   creativity, this study took a comprehensive, multimodal approach to
   explore predictors of creative activities and (scientific and artistic)
   creative achievements in N = 431 gifted secondary school students. Using
   self- and parent-reports, performance tests, and a machine learning
   approach, over 40 theoretically derived predictors from personality,
   motivation, and cognitive domains were analyzed. Our results broadly
   aligned with the pattern of associations from adult samples and revealed
   domain-specific differences. Important predictors identified by machine
   learning included openness, creative self-efficacy, artistic and
   investigative vocational interests, and divergent thinking. Structural
   equation modeling showed that intellectual curiosity and investigative
   interests were the strongest predictors of scientific creative
   achievement, whereas aesthetic sensitivity was the strongest predictor
   of artistic creative achievement. Creative activities partly mediated
   the associations. Our findings underscore the multidimensional nature of
   creativity in gifted adolescents during an important stage of talent
   development and highlight key factors by distinguishing robust
   predictors from simple correlates.},
DOI = {10.1177/08902070261458201},
EarlyAccessDate = {JUN 2026},
ISSN = {0890-2070},
EISSN = {1099-0984},
ResearcherID-Numbers = {Trautwein, Ulrich/C-3064-2011
   Roberts, Brent/HCH-8716-2022},
Unique-ID = {WOS:001806918400001},
}

@article{ WOS:001805373600001,
Author = {Yin, Lu and Liu, Yunbo and Zhang, Wenqi},
Title = {Cracking the Black Box of Non-Cognitive Skills of Upper-Secondary
   Vocational School Students: Empirical Evidence From Four Provinces in
   China},
Journal = {EUROPEAN JOURNAL OF EDUCATION},
Year = {2026},
Volume = {61},
Number = {3},
Month = {JUN 26},
Abstract = {Non-cognitive skills are important for students' growth and future work
   and life. Using the 2018 PISA (B-S-Z-J China) data, this study measured
   the non-cognitive skills of upper-secondary vocational school students
   relative to general high school students and studied the impact of
   family factors and school factors on the non-cognitive skills of
   upper-secondary vocational education students. The empirical results
   show that upper-secondary vocational school students are not weaker than
   general high school students regarding conscientiousness, emotional
   stability or resilience. Parental emotional support, teachers'
   enthusiasm for teaching and school cooperation atmosphere have a
   positive impact on the non-cognitive skills of upper-secondary
   vocational education students. Building relational and emotional
   connections associated with people and soft resource inputs to enhance
   the non-cognitive skills of upper-secondary vocational education
   students should be the focus.},
DOI = {10.1111/ejed.70755},
Article-Number = {e70755},
ISSN = {0141-8211},
EISSN = {1465-3435},
Unique-ID = {WOS:001805373600001},
}

@article{ WOS:001802723400001,
Author = {Santiago-Rosario, Maria Reina and Falcon, Sarah Fairbanks and Austin,
   Sean C. and Nese, Joseph F. T. and Sullivan, Maeghan M. and Daza, Tony
   and Calhoun, T. Elyse and Cerdan, Haley and Nese, Rhonda N. T.},
Title = {Bridging the Gap: A Case Study of Tailored Support for Students with
   Social, Emotional, and Behavioral Needs During the Transition to High
   School},
Journal = {BEHAVIORAL SCIENCES},
Year = {2026},
Volume = {16},
Number = {6},
Month = {JUN 12},
Abstract = {Students with disabilities, particularly those needing additional
   support or intervention to manage emotions and behaviors, build healthy
   relationships, and navigate social and academic demands, face heightened
   risks of high school pushout that can be traced back to their transition
   into high school. Project Elevate (PE) is a multi-component intervention
   that strategically invests in early coordinated student, family, and
   school supports to prevent barriers associated with high school pushout,
   such as a lack of continuity of effective services across school sites.
   This mixed-methods pilot study examined the implementation of PE with
   three 8th-grade students and their parents during their last term in
   middle school. This study includes quantitative pre-post descriptive
   analyses of multi-informant reports of students' social, emotional, and
   behavioral skills, as well as descriptive analyses of weekly teacher-
   and parent-reported behavior and student attendance. Qualitative
   analysis using the Framework Method was applied to student and parent
   interviews and open-ended responses on a satisfaction questionnaire to
   understand their experience receiving PE support. Session case notes
   were also used as contextual data to describe implementation processes
   and contextualize findings. Results indicated improvements in student
   attendance and reductions in home-based behavioral concerns, with mixed
   findings across school-based outcomes. Students and parents reported
   high satisfaction with the intervention, highlighting the value of
   individualized support, goal setting, and strengthened communication
   with schools. Findings from this intervention development pilot study
   provide preliminary evidence regarding the implementation and perceived
   value of PE. Results also highlight the importance of culturally
   responsive, relationship-centered practices that affirm student
   strengths and support access to educational opportunities. Further
   investigation of PE in larger studies is warranted.},
DOI = {10.3390/bs16060984},
EarlyAccessDate = {JUN 2026},
Article-Number = {984},
EISSN = {2076-328X},
ResearcherID-Numbers = {/HRA-9028-2023
   Falcon, Sarah/LDF-4696-2024},
Unique-ID = {WOS:001802723400001},
}

@inproceedings{ WOS:001786354900032,
Author = {Callea, Viviana and John, Isabel and Nantsou, Tina and Ursache, Mihai
   and Matrisciano, Apollonia},
Editor = {Auer, ME and Toth, P},
Title = {Integration Between Coaching and Engineering for Building a New
   Behavioural Guidance Tool COACH\_ING},
Booktitle = {INNOVATION VIA COLLABORATIVE LEARNING IN ENGINEERING EDUCATION, ICL
   2025, VOL 2},
Series = {Lecture Notes in Networks and Systems},
Year = {2026},
Volume = {1847},
Pages = {338-349},
Note = {28th International Conference on Interactive Collaborative Learning-ICL,
   Budapest University of Technology \& Economics, Budapest, HUNGARY, OCT
   01-03, 2025},
Abstract = {In the current context, innovative tools are needed to support students
   and young professionals. The COACH\_ING (R) model, born through the
   integration of coaching and engineering approaches, is a method for
   guiding individuals in the development of strategic skills. The model
   enables guidance in academic and professional choices, collaborative
   learning processes and construction of a reference system, fostering a
   conscious decision-making approach, equal relationships, and
   self-awareness. The research objective is twofold: to develop and
   validate the effectiveness of a self-assessment tool for COACH\_ING
   called Sel4COACH\_ING and to confirm the effectiveness of the derived
   model for academic and professional guidance. The questions that guided
   our research are: What emerges from the comparison between direct
   self-assessment and the perception of specific behavioural skills? How
   can a reliable feedback system show the realistic level of mastery of
   skills?
   The COACH\_ING model has been applied through self-assessment sessions
   and behavioural analysis on three-phases: 1. Classification of 16 skills
   of the model and four macro areas; 2. Attribution of specific behaviours
   to each skill in the model and subdivision of the specific behaviours
   according to three levels of mastering of each skill. 3. Development of
   the new tools.
   The outcomes are: identification of discrepancies between
   self-assessment and own perception of skills, new tools for skill
   monitoring, strengthening of decision-making capabilities and awareness
   in the choice-making process, and value of collaborative learning.
   The model's effectiveness of the new COACH\_ING tools including
   Sel4COACH\_ING specifically designed to meet the needs of the market is
   highlighted.},
DOI = {10.1007/978-3-032-18885-4\_32},
ISSN = {2367-3370},
EISSN = {2367-3389},
ISBN = {978-3-032-18884-7; 978-3-032-18885-4},
Unique-ID = {WOS:001786354900032},
}
