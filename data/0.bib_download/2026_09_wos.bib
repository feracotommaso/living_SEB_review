
@article{ WOS:001883205000001,
Author = {Zhang, Jianhua and Wang, Faming and King, Ronnel B. and Garbacz, Andy},
Title = {Which social contexts best predict adolescents' social-emotional skills:
   Combining machine learning and traditional statistics},
Journal = {JOURNAL OF SCHOOL PSYCHOLOGY},
Year = {2026},
Volume = {118},
Month = {OCT},
Abstract = {Social-emotional skills have been demonstrated to be crucial for
   adolescents' success in the 21st century. However, past studies have
   primarily focused on the consequences of these skills, with little
   attention devoted to understanding the factors that could facilitate
   these skills. This gap prevents educators from targeting the most
   important factors that could lead to improvements in adolescents'
   social-emotional skills. To address this gap, this study aimed to
   examine the role of distinct family, school, peer, and community factors
   in predicting adolescents' social-emotional skills. We utilized data
   from the Organization for Economic Co-operation and Development's Survey
   on Social and Emotional Skills, including 29,798 15-year-olds from nine
   countries. An integrative modeling approach that combined machine
   learning (i.e., Extra Gradient Boost) and traditional statistics (i.e.,
   hierarchical linear modeling) was used to rank the relative importance
   of factors in predicting adolescents' social-emotional skills. Results
   revealed that school belonging was, by far, the most important predictor
   of all the different types of social-emotional skills. Other important
   predictors included social connectedness, school cooperation, and
   parents' socialemotional skills. This study not only highlights the
   complexity of factors that might be associated with adolescents'
   social-emotional skills but also provides empirical evidence to help
   educators identify the most effective targets for educational
   interventions.},
DOI = {10.1016/j.jsp.2026.101554},
EarlyAccessDate = {SEP 2026},
Article-Number = {101554},
ISSN = {0022-4405},
EISSN = {1873-3506},
ResearcherID-Numbers = {King, Ronnel/AGZ-0675-2022
   Wang, Faming/ADA-5335-2022},
Unique-ID = {WOS:001883205000001},
}

@article{ WOS:001878147700001,
Author = {van der Linden, Dimitri and Dunkel, Curtis S. and Mansolf, Maxwell and
   Chen, Zhuo Job and Musek, Janek and Petrides, V, K.},
Title = {The hidden redundancy in psychological trait measures: A general factor
   of personality (GFP) perspective},
Journal = {PERSONALITY AND INDIVIDUAL DIFFERENCES},
Year = {2027},
Volume = {264},
Month = {JAN},
Abstract = {In psychology there is a plethora of different measures and constructs.
   However, the literature also shows that many of these measures overlap
   and may even sometimes be redundant. Recognizing such overlap in
   measures is essential for consolidation and for moving the field
   forward. Accordingly, we suggest a role herein of the General Factor of
   Personality (GFP), which emerges from the correlations between specific
   personality dimensions and reflects a mix of desirable traits (e.g.
   being sociable, honest, and emotionally stable). It is argued and shown
   that the GFP is highly correlated with a wide range of psychological
   traits. We further postulate that this phenomenon provides a
   parsimonious way of looking at the overlap between many trait measures.
   This idea is discussed in light of the ongoing debate on the GFP in
   which some scholars suggest the general factor is substantive and
   relevant for understanding personality, whereas others consider it to
   solely reflect a measurement artifact. Irrespective of whether the
   substantive, artifact, or a mixed explanation of the GFP is adopted,
   overlooking the presence of a common general factor in psychological
   measures may, respectively, either impede the development of unifying
   theories of human behavior, or otherwise compromise measurement
   validity.},
DOI = {10.1016/j.paid.2026.114085},
EarlyAccessDate = {SEP 2026},
Article-Number = {114085},
ISSN = {0191-8869},
EISSN = {1873-3549},
ResearcherID-Numbers = {Musek, Janek/P-8278-2018},
Unique-ID = {WOS:001878147700001},
}

@article{ WOS:001866885500001,
Author = {Engelbrecht-Aldworth, Erika and Toendepi, Joyce},
Title = {Understanding educators' spiritual awareness and well-being in selected
   South African secondary schools},
Journal = {JOURNAL OF BELIEFS \& VALUES-STUDIES IN RELIGION \& EDUCATION},
Year = {2026},
Month = {2026 SEP 4},
Abstract = {The South African education system is characterised by overwhelming
   workloads, limited resources, fear of violence, and a lack of
   opportunities for advancement. Work is no longer just about completing
   tasks; it also encompasses personal fulfilment, social interaction, and
   building connections with others. Spirituality offers individuals a
   profound sense of self-worth, fosters deep connections with themselves
   and others, and empowers them to influence the world through meaningful
   actions. The objective of this study was to understand the lived
   experience of spiritual awareness and well-being of educators in
   selected secondary schools in South Africa. A qualitative interpretivist
   approach was adopted, involving interviews with 12 secondary school
   educators who were purposefully sampled. Semi-structured interviews were
   conducted, and the data was analysed thematically. Participants reported
   feelings of professional depersonalisation, burnout, and exhaustion, but
   found solace in their spirituality. The findings revealed that spiritual
   awareness enhances well-being and self-efficacy, boosting educators'
   motivation to support learners. Additionally, spiritual coping helps
   educators remain focused. The findings highlight the need to prioritise
   the well-being of secondary school educators in South Africa by
   integrating spiritual aspects into education, thereby improving
   cognitive abilities, emotional health, and connectedness with oneself
   and a higher power.},
DOI = {10.1080/13617672.2026.2715657},
EarlyAccessDate = {SEP 2026},
ISSN = {1361-7672},
EISSN = {1469-9362},
ResearcherID-Numbers = {Toendepi, Joyce/AER-9412-2022},
Unique-ID = {WOS:001866885500001},
}

@article{ WOS:001866593600001,
Author = {Haehner, Peter and Asselmann, Eva and Baumgardt, Saskia and Brueggmann,
   Lena and Denissen, Jaap J. A. and Harzer, Claudia and Juchem, Christina
   M. and Kramer, Michael D. and Kuper, Niclas and Puhlmann, Lara M. C. and
   Zimmermann, Johannes and Bleidorn, Wiebke},
Title = {Ten Concerns About Volitional Personality-Change Interventions-and How
   to Address Them},
Journal = {PERSPECTIVES ON PSYCHOLOGICAL SCIENCE},
Year = {2026},
Month = {2026 SEP 3},
Abstract = {Many people want to change their personality in some way, and
   personality traits have been found to predict various important aspects
   of life, including well-being, health, relationship quality, and work
   success. As a result, volitional personality interventions designed to
   elicit personality-trait change in desired directions have recently
   gained momentum in research and public discourse. Although the initial
   evidence on the effectiveness of these interventions is promising,
   concerns regarding their benefits, risks, and societal implications
   remain underexplored. In this review, we discuss 10 concerns regarding
   methodological, ethical, and practical limitations of volitional
   personality-change interventions. Drawing on research across different
   areas of psychology, we provide a balanced discussion of each concern
   and outline directions for future research and practical applications of
   these interventions. Volitional personality-change interventions have
   the potential to improve people's lives and increase satisfaction with
   the self. However, realizing this potential requires sustained research
   effort, thoughtful study design, and careful implementation of these
   interventions to maximize benefits and mitigate concerns.},
DOI = {10.1177/17456916261466950},
EarlyAccessDate = {SEP 2026},
ISSN = {1745-6916},
EISSN = {1745-6924},
ResearcherID-Numbers = {Harzer, Claudia/AAA-9242-2019
   Kuper, Niclas/AAP-4970-2020
   Krämer, Michael/AAK-8717-2020
   Haehner, Peter/AEF-1867-2022
   Juchem, Christina/OAJ-2258-2025
   Asselmann, Eva/ABD-6260-2020
   Denissen, Jaap/H-2180-2013},
ORCID-Numbers = {Harzer, Claudia/0000-0001-7393-4793
   Krämer, Michael Dominik/0000-0002-9883-5676
   Brüggmann, Lena/0009-0005-0202-7834
   },
Unique-ID = {WOS:001866593600001},
}

@article{ WOS:001863846500001,
Author = {Tang, Xin and Fang, Yirou and Wu, Tao and Pan, Xianglin and Zhan, Jian
   and Liu, Zepeng and Ali, Farhan and Guo, Jiesi and Chen, Jingyuan and
   Wu, Fei},
Title = {Large language models and social-emotional learning: Promise, limits,
   and conditions for responsible use},
Journal = {LEARNING AND INDIVIDUAL DIFFERENCES},
Year = {2026},
Volume = {131},
Month = {OCT},
Abstract = {The educational artificial intelligence literature has developed rapidly
   around cognitive uses of large language models (LLMs), with
   comparatively little systematic attention to their role in
   social-emotional learning (SEL). In this paper, we synthesize two
   strands of recent research to argue that contemporary LLMs warrant
   serious consideration as infrastructure for SEL. The first strand
   documents that contemporary LLMs can generate responses on
   social-emotional tasks that approach or exceed average human
   performance. The second strand reports growing empirical evidence that
   LLM-based interventions can support social-emotional skills development.
   We also provide further evidence with our own cross-linguistic
   evaluation of five LLMs (GPT-3.5, GPT-4, DeepSeek-R1, Ernie, and Qwen)
   using the OECD Survey of Social and Emotional Skills framework. Our
   results suggest that current models can display broad SEL-relevant
   response patterns, especially in English, and that these patterns are
   highly responsive to simple prompting. We close by outlining application
   scenarios and safeguards for responsible deployment, including privacy
   protection, cultural validation, transparent AI labelling, crisis
   escalation, and human oversight.},
DOI = {10.1016/j.lindif.2026.102990},
EarlyAccessDate = {AUG 2026},
Article-Number = {102990},
ISSN = {1041-6080},
EISSN = {1873-3425},
ResearcherID-Numbers = {Fang, Yirou/OSI-8098-2025
   Tang, Xin/I-7765-2012
   },
ORCID-Numbers = {Tang, Xin/0000-0002-0155-4967
   Fang, Yirou/0009-0009-3029-0022},
Unique-ID = {WOS:001863846500001},
}

@article{ WOS:001861173600001,
Author = {Sharabi, Adi},
Title = {Understanding Academic Adjustment in Undergraduates With SLD or ADHD: An
   Integrative Model of Social-Emotional-Behavioral Skills, Academic
   Self-Efficacy, and Self-Regulated Learning},
Journal = {LEARNING DISABILITIES RESEARCH \& PRACTICE},
Year = {2026},
Month = {2026 AUG 27},
Abstract = {Students with specific learning disorders (SLD) and/or
   attention-deficit/hyperactivity disorder (ADHD) often face challenges in
   higher education; however, the role of personal and study-related
   resources in their academic adjustment is not fully understood. This
   study examined the associations between an SLD/ADHD diagnosis and
   academic achievement and satisfaction, focusing on the mediating role of
   social, emotional, and behavioral (SEB) skills, academic self-efficacy
   (ASE), and self-regulated learning (SRL). Participants were 651
   undergraduates, including 318 students with SLD/ADHD, who completed
   self-reports of SEB skills, ASE, SRL, academic satisfaction, and grade
   point average. Students with SLD/ADHD reported significantly lower
   levels across all study variables than peers without disabilities.
   Structural equation modeling indicated that SEB, ASE, and SRL operated
   as parallel mediators of the association of diagnosis with academic
   satisfaction, whereas ASE uniquely mediated the association with
   academic achievement. These findings clarify mechanisms underlying
   academic adjustment in higher education for individuals with SLD/ADHD
   and, therefore, have implications for delivery of support to this
   student population.},
DOI = {10.1177/09388982261483237},
EarlyAccessDate = {AUG 2026},
ISSN = {0938-8982},
EISSN = {1540-5826},
ResearcherID-Numbers = {Sharabi, Adi/PII-0298-2026},
Unique-ID = {WOS:001861173600001},
}

@article{ WOS:001886483600001,
Author = {Mason, Lucia and Carretti, Barbara},
Title = {Introduction to the special Issue-35th annual meeting of the Society for
   Text and Discourse},
Journal = {DISCOURSE PROCESSES},
Year = {2026},
Volume = {63},
Number = {6-7, SI},
Pages = {475-481},
Month = {AUG 9},
Abstract = {This special issue of Discourse Processes highlights work presented at
   the 35th annual meeting of The Society for Text \& Discourse (ST\&D)
   held in Padua, Italy in July 2025. The special issue opens with the
   thought-provoking contribution by Arthur Glenberg, the winner of the
   ST\&D Distinguished Scientific Contribution Award in 2025. The
   conference-based special collection then includes contributions
   regarding a range of relevant issues and challenges of research in four
   main areas: (1) reading, evaluating, and comprehending digital texts;
   (2) reading processes and outcomes; (3) spatial representations as tools
   for effective discourse processing and comprehension; and (4)
   discourse-based complex problem-solving. The contributions highlight
   that attention should be paid to the real context where cognitive
   processes are activated, the importance of motivational-emotional
   drivers while understanding written and oral discourse, and the use of
   up-to-date statistical procedures. The multidisciplinary and
   international character of our society is also well reflected in the
   contributions.},
DOI = {10.1080/0163853X.2026.2707631},
ISSN = {0163-853X},
EISSN = {1532-6950},
Unique-ID = {WOS:001886483600001},
}

@article{ WOS:001728004700001,
Author = {Ducheyne, David and De Fruyt, Filip},
Title = {Distinguishing destructive/toxic from incompetent leadership},
Journal = {INDUSTRIAL AND ORGANIZATIONAL PSYCHOLOGY},
Year = {2026},
Volume = {19},
Number = {3},
Pages = {245-258},
Month = {SEP},
Abstract = {We argue that it is both timely and critical to make a clearer
   distinction between destructive/toxic and incompetent leadership to
   advance research and better mitigate the problems with leadership
   quality. To achieve this, we first review and integrate the fragmented
   literature on the subject and specify what competent and effective
   leadership is. We then propose an operational definition of toxic
   leadership that is useful for practitioners to make a better distinction
   between toxic and incompetent leadership. We finally provide
   recommendations to avoid and deal with toxic leadership in organizations
   and discuss research directions.},
DOI = {10.1017/iop.2026.10070},
EarlyAccessDate = {MAR 2026},
ISSN = {1754-9426},
EISSN = {1754-9434},
ResearcherID-Numbers = {De Fruyt, Filip/A-3083-2009},
Unique-ID = {WOS:001728004700001},
}

@article{ WOS:001870710200001,
Author = {Zhang, Shuai and Wu, Wenxi and Wu, Jiheng and Chen, Ge and Zhao, Rui and
   Xu, Binyan},
Title = {Network analysis of Chinese and Finnish students' social-emotional
   skills: A cross-cultural comparative study},
Journal = {JOURNAL OF PSYCHOLOGY IN AFRICA},
Year = {2026},
Volume = {36},
Number = {4},
Pages = {575-587},
Abstract = {Social-emotional skills (SES) are foundational to academic success and
   well-being, yet limited research has examined how these skills are
   structurally organized as an interconnected system across cultural
   contexts. Drawing on data from the 2023 OECD Survey on Social and
   Emotional Skills (SSES; 48.97\% females, mean age = 13.09, SD = 2.21
   years). Results from Gaussian Graphical Models (GGM) identify optimism
   and curiosity as universal hub nodes across both cultural contexts.
   Culturally, the Chinese SES network exhibits higher connectivity and
   integration, with the Emotional Regulation domain serving as a primary
   organizational anchor. In contrast, the Finnish network displays a more
   differentiated structure, with the Engaging with Others domain showing
   stronger central connectivity. Developmentally, the transition from
   children (age 10) to adolescence (age 15) is associated with significant
   network consolidation, as indicated by increased global strength in both
   contexts. Gender differences are reflected in distinct centrality
   patterns: male students prioritize Stress Resistance and Emotional
   Control as key nodes, while female students show stronger integration
   between Collaboration and Task Performance domains. Socioeconomic status
   (SESs) was associated with culturally contingent centrality patterns.
   Low-SESs Chinese students' networks were more strongly anchored by
   Emotional Regulation and Task Performance facets, whereas low-SESs
   Finnish students showed higher centrality in Open-Mindedness facets.
   Consistent with Stage-Environment Fit theory, these findings indicate
   how cultural context, developmental stage, gender, and socioeconomic
   resources shape the structural organization of SES, providing
   theoretical insights for culturally responsive social-emotional
   education.},
DOI = {10.32604/jpa.2026.076330},
ISSN = {1433-0237},
EISSN = {1815-5626},
Unique-ID = {WOS:001870710200001},
}
