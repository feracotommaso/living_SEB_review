	title = {Perspectives on caregiver-reported outcomes in cardiovascular diseases today and in future healthcare services: a statement of Association of Cardiovascular Nursing & Allied Professions (ACNAP), Association for Acute CardioVascular Care (ACVC), the Heart Failure Association (HFA), ESC Council on Stroke, and Global Heart Hub, the International Alliance of Heart Patient Organisations},
