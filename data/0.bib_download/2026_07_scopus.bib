	number = {3},
	pages = {1072 - 1113},
	doi = {10.1177/13872877261459125},
	url = {https://www.scopus.com/pages/publications/105045764446?origin=resultslist},
	abstract = {Psychosocial interventions are widely used in dementia care, yet standardized outcome measurement remains highly variable, and recent frameworks emphasize outcomes prioritized by people living with dementia and their care partners. This narrative, measurement-focused review does not appraise or synthesize treatment effects. Instead, it aims to map outcome measures to the International Consortium for Health Outcomes Measurement (ICHOM) dementia set plus an additional carer-wellbeing domain, to organize them into a taxonomy of wellbeing domains that highlights patterns and gaps in measurement practice. Eligible studies included participants with Alzheimer's disease and related dementias, evaluated a psychosocial intervention, and reported standardized pre- and post-intervention outcome measures at short and/or long-term follow-up. A total of 136 studies met inclusion criteria. Interventions encompassed arts and creative therapies, cognitive and reminiscence approaches, education and psychosocial support, physical and movement-based therapies, sensory and relaxation therapies, environmental and daily living support, and animal/robot-assisted programs. Outcome measures clustered on neuropsychiatric symptoms (205 instances) and cognitive functioning (146 instances), with fewer measures of social functioning (22 instances) and health-related quality of life (13 instances). Measurement approaches were highly variable (43 distinct neuropsychiatric measures, 47 cognitive measures, 14 social functioning measures). Outcomes were predominantly assessed using short-term measures, with some long-term follow-up, and few observational in-the-moment measures capturing engagement, enjoyment, reciprocity or mastery. This review presents a taxonomy of outcome measures that highlights the mismatch between current evaluation practices and person-centered psychosocial priorities in dementia care, and guides more purposeful measure selection. © The Author(s) 2026},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Beigi20201,
	author = {Beigi, Ruksana},
	title = {Early Years Pedagogy in Practice: A Guide for Students and Practitioners},
	year = {2020},
	journal = {Early Years Pedagogy in Practice: A Guide for Students and Practitioners},
	pages = {1 - 326},
	doi = {10.4324/9780429430473},
	url = {https://www.scopus.com/pages/publications/105044182775?origin=resultslist},
	abstract = {This accessible text encourages readers to understand and confidently engage with distinctive early years pedagogy. It shows how pedagogy not only underpins the early years curriculum but is also inherent in the role of the adult and the experiences that are offered to young children. The book explains what the differing early years pedagogies are, why they are encouraged, and the knowledge, skills, and practice that are required to work with them. Emphasising that what works in one situation may not in another and a wider pedagogical knowledge is essential to ensure quality outcomes for children, it considers key topics such as: the role of the pedagogue and developing your own style promoting a lifelong love of learning in children under your care sensitivity and inclusion for all children's cultures and communities promoting the rights of every child under your care. Incorporating reflection points and research tasks to support independent learning, this is essential reading for students on Early Childhood Studies courses and Early Years Foundation Degrees as well as early years practitioners. © 2021 Ruksana Beigi.},
	type = {Book},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@BOOK{Brito20261,
	author = {Brito, Dhemy and Ferreira, Fernando Ilídio and Çan, Jasemin and Caputo, Stela Guedes},
	title = {Innovative Research Methods in Childhood Studies: Participation, Creativity and Reflexivity},
	year = {2026},
	journal = {Innovative Research Methods in Childhood Studies: Participation, Creativity and Reflexivity},
	pages = {1 - 493},
	url = {https://www.scopus.com/pages/publications/105043615239?origin=resultslist},
	abstract = {Research involving children has undergone a significant transformation over recent decades, influenced by the emergence of Childhood Studies and broader epistemological shifts that recognize children as active participants in social life. Rather than being viewed solely as subjects of observation or developmental assessment, children are increasingly understood as competent social actors embedded within cultural, relational, and political contexts. This shift has created a growing need for methodological approaches that can more effectively capture the complexity, agency, and diversity of children’s lived experiences. In response, researchers are adopting more participatory, ethical, and inclusive methods that center children’s voices and perspectives. These approaches not only enrich the quality of research but also contribute to more equitable and representative knowledge production. Innovative Research Methods in Childhood Studies: Participation, Creativity and Reflexivity offers theoretical, methodological, and practical insights into contemporary approaches to research with children, integrating diverse paradigms and disciplinary perspectives. Grounded in Childhood Studies and the Sociology of Childhood, this book examines qualitative, participatory, visual, narrative, and digital methodologies, emphasizing ethical and creative ways of producing knowledge with children rather than simply about them. Covering topics such as rural children, ethnographic immersion, and well-being measurement, this book is an excellent academic resource for graduate and doctoral students, educators, cultural mediators, social workers, community-based practitioners, policymakers, NGO leaders, and more. Coverage: The many academic areas covered in this publication include, but are not limited to: Agency Child-Friendly Research Communication Childhood Studies Ethical Dimensions Ethnographic Immersion Forms of Expression Political Dimensions Preschool Settings Research Methods Rights-Operationalized Participation Rural Children Sociology of Childhood Visual-Sensory Methods Well-Being Measurement. © 2027 by IGI Global Scientific Publishing. All rights reserved.},
	type = {Book},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

