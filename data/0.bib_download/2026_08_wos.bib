
@article{ WOS:001856780100001,
Author = {Tan, Yuting and Mendoza, Norman B. and Yeung, Susanna Siu-sze},
Title = {Cultural variations in the relationship between school belonging and
   social-emotional skills: a multi-group structural equation modeling
   (SEM) analysis},
Journal = {LARGE-SCALE ASSESSMENTS IN EDUCATION},
Year = {2026},
Volume = {14},
Number = {1},
Month = {AUG 24},
Abstract = {Social-emotional skills are crucial for student development yet they
   decline significantly during secondary education globally, raising
   questions about effective interventions. While school belonging is
   theorized to support social-emotional development, its cross-cultural
   universality remains contested. This study examined associations between
   school belonging and ten social-emotional skill dimensions across eight
   cultural regions using PISA 2022 data from 527,255 students in 74
   countries. Multi-group structural equation modeling revealed positive
   associations globally, but substantial cross-cultural variation emerged.
   Harmony-embeddedness cultures (Latin America, South/Southeast Asia)
   showed the strongest effects, while autonomy-oriented cultures (Western
   Europe, English-speaking) and Confucian societies exhibited minimal
   associations. These findings challenge universal assumptions about
   belonging interventions, demonstrating that cultural values function as
   crucial contextual factors that amplify, suppress, or redirect
   belonging's developmental impact. Results necessitate culturally
   responsive approaches to social-emotional development rather than
   one-size-fits-all interventions, highlighting the importance of
   understanding diverse pathways to human flourishing across cultural
   contexts.},
DOI = {10.1186/s40536-026-00314-w},
EarlyAccessDate = {AUG 2026},
Article-Number = {39},
EISSN = {2196-0739},
Unique-ID = {WOS:001856780100001},
}

@article{ WOS:001854573300020,
Author = {Beccassino, Luciana and Borbon, Juliana and Cuartas, Jorge and
   Rey-Guerra, Catalina and Gutierrez-Torres, Maria Alejandra and Guerra,
   Melissa and Baker-Henningham, Helen},
Title = {Social and emotional skills for nurturing parenting: A qualitative
   examination},
Journal = {PLOS ONE},
Year = {2026},
Volume = {21},
Number = {8},
Month = {AUG 20},
Abstract = {Social and emotional skills develop within cultural contexts and shape
   parenting behaviors, yet little work has examined the specific skills
   parents themselves consider important for parenting, or the factors they
   perceive as supporting these skills, in low- and middle-income countries
   (LMICs). Centering parents' own conceptualizations, this two-phase
   descriptive qualitative study with 54 parents living in Colombia
   combined an initial phase of focus groups and individual interviews with
   a second phase of targeted individual interviews, and used thematic
   analysis to explore the social and emotional skills parents identify as
   relevant to parenting and the risk and protective factors perceived to
   hinder or enhance their development. Our findings highlight the
   importance of emotional awareness, self-regulation, communication,
   cooperation, and problem-solving skills in adulthood for nurturing
   parenting and promoting children's social and emotional development.
   Parents' upbringing and support networks emerged as significant factors
   shaping skill development and child-rearing practices. These findings
   emphasize the need for policies and interventions, grounded in
   caregivers' own perspectives, to promote social and emotional skills for
   parents in LMIC contexts.},
DOI = {10.1371/journal.pone.0355716},
EarlyAccessDate = {AUG 2026},
Article-Number = {e0355716},
EISSN = {1932-6203},
Unique-ID = {WOS:001854573300020},
}

@article{ WOS:001847513500001,
Author = {Kogler, Andrea and Barth, Maximilian and Prinz, Katharina and Paleczek,
   Lisa and Gasteiger-Klicpera, Barbara},
Title = {Self-Assessment of Social-Emotional Skills in Primary Students:
   Psychometric Evaluation of the Digital Screening Instrument GraSEF},
Journal = {CHILD PSYCHIATRY \& HUMAN DEVELOPMENT},
Year = {2026},
Month = {2026 AUG 12},
Abstract = {Early assessment of social-emotional skills is crucial for identifying
   children at risk and implementing targeted interventions. To address the
   scarcity of reliable self-reports for young children, we developed the
   GraSEF, a digital screening instrument for primary students. GraSEF
   utilizes a situational judgment format to assess
   internalizing/externalizing behavior, social withdrawal,
   problem-solving, alongside self-reports for prosocial behavior and
   emotion regulation strategies. This study examines the instrument's
   psychometric properties in a sample of 474 s-graders in Austria (M age =
   7.66 years, SD = 0.42; 52.1\% girls). Divergent and convergent validity
   were examined via teacher- and self-report scales. Confirmatory factor
   analyses supported a robust six-factor model with scalar invariance
   across gender and family language. Results demonstrated acceptable to
   good internal consistency, and stable test-retest reliability. However,
   low student-teacher agreement was observed, which warrant further
   investigation. GraSEF proves to be a reliable instrument for assessing
   student's social-emotional skills and behavior problems.},
DOI = {10.1007/s10578-026-02078-4},
EarlyAccessDate = {AUG 2026},
ISSN = {0009-398X},
EISSN = {1573-3327},
ResearcherID-Numbers = {Gasteiger-Klicpera, Barbara/GYD-4597-2022
   Paleczek, Lisa/JVO-5775-2024
   },
ORCID-Numbers = {Barth, Maximilian/0000-0003-3428-4075},
Unique-ID = {WOS:001847513500001},
}

@article{ WOS:001857087900001,
Author = {Aygun, Hanife Esen and Asikcan, Mehmet and Zeren, Serife Gonca},
Title = {Development and psychometric validation of the soft skills scale for
   primary school students},
Journal = {FRONTIERS IN PSYCHOLOGY},
Year = {2026},
Volume = {17},
Month = {AUG 11},
Abstract = {This study aimed to develop a Soft Skills Scale for primary school
   students and to determine its psychometric properties. A total of 2,418
   primary school students participated in the scale development process.
   Principal component analysis revealed a six-factor, 19-item structure
   explaining 41.37\% of the total variance. Confirmatory factor analysis
   provided additional evidence supporting the proposed six-factor
   structure, with acceptable model fit indices. Criterion-related validity
   was supported by a moderate positive correlation. Test-retest
   reliability, assessed over a four-week period, yielded a correlation
   coefficient of 0.83, indicating strong temporal stability. Internal
   consistency coefficients are Cronbach's alpha of 0.79 and McDonald's
   omega of 0.80 for the overall scale. The findings provide evidence
   supporting the reliability and construct validity of the SSS-S for
   assessing soft skills among primary school students within the context
   of the current sample. The Soft Skills Scale for primary school students
   address a significant gap in literature by providing one of the first
   scale designed to comprehensively assess interpersonal, cognitive,
   emotional, and behavioral components of soft skills in primary school
   students. The developed scale is expected to contribute to
   classroom-based interventions and school counseling practices.
   Additionally, the SSS-S has the potential to contribute to future
   international comparative studies. However, additional evidence
   regarding cross-cultural validity and measurement invariance is needed
   before such applications can be supported.},
DOI = {10.3389/fpsyg.2026.1906409},
EarlyAccessDate = {AUG 2026},
Article-Number = {1906409},
ISSN = {1664-1078},
Unique-ID = {WOS:001857087900001},
}

@article{ WOS:001843377500001,
Author = {Kramer, Michael D. and Wright, Amanda J. and Haehner, Peter and
   Zimmermann, Johannes and Fluckiger, Christoph and Hopwood, Christopher
   J. and Bleidorn, Wiebke},
Title = {Self-Efficacy Predicts Differential Neuroticism Change in a
   Smartphone-Based Intervention},
Journal = {JOURNAL OF PERSONALITY AND SOCIAL PSYCHOLOGY},
Year = {2026},
Month = {2026 AUG 10},
Abstract = {Self-guided, digital interventions can help people change their
   personality traits in desired directions, including becoming less
   neurotic. However, little is known about how and why people differ in
   intervention-related changes. Theoretical models state that intentional
   personality change must be perceived as feasible and that being
   motivated to change is not sufficient to elicit lasting trait changes.
   Using a German-speaking sample (N = 446; M-age = 25.88; 85\% female;
   Residence: 47\% Switzerland, 26\% Germany, 26\% Austria, 1\% other), we
   tested whether self-efficacy and growth mindset predict change in
   multiple neuroticism measures across a 6-week intervention and 2-month
   follow-up. To isolate temporal processes during the intervention, we
   examined codevelopment of weekly neuroticism and self-efficacy and their
   week-to-week temporal associations. We found evidence for self-efficacy
   predicting differential neuroticism change but not for growth mindset.
   Participants with higher self-efficacy showed greater pre-post decreases
   in self-reported neuroticism and greater pre-post increases in emotional
   resilience than those with lower self-efficacy. At follow-up,
   participants with higher self-efficacy continued to improve more in
   neuroticism and emotional resilience. Last, higher self-efficacy in 1
   week predicted lower neuroticism in the following week, and vice versa,
   independent of participants' overall trajectories. In contrast, there
   was no consistent evidence for between-person codevelopment of weekly
   self-efficacy and neuroticism across the intervention. Findings support
   theoretical expectations that perceived feasibility is a precondition
   for neuroticism change and suggest possible reinforcement mechanisms
   between weekly self-efficacy and neuroticism. We discuss implications
   for theory and future intervention studies.},
DOI = {10.1037/pspp0000610},
EarlyAccessDate = {AUG 2026},
ISSN = {0022-3514},
EISSN = {1939-1315},
ResearcherID-Numbers = {Krämer, Michael/AAK-8717-2020
   Wright, Amanda/HNT-0630-2023
   Haehner, Peter/AEF-1867-2022
   Flückiger, Christoph/H-8169-2014},
ORCID-Numbers = {Krämer, Michael Dominik/0000-0002-9883-5676
   },
Unique-ID = {WOS:001843377500001},
}

@article{ WOS:001842253400001,
Author = {Irvin, Roberta L. and Vohra, Pranika and Lawrence, Grace A. and
   Robinson, Michael D.},
Title = {Behavioral tendencies of success: toward a verb-like conception of
   successful life functioning},
Journal = {JOURNAL OF POSITIVE PSYCHOLOGY},
Year = {2026},
Month = {2026 AUG 8},
Abstract = {Can a test reveal whether individuals will succeed or struggle in their
   lives? This question was pursued through the use of a Behavioral
   Tendencies in Life Test (BTLT), which asks individuals whether they
   would respond to 40 life-modeling scenarios in each of 4 ways. A
   prototype of the successful person was created using the same materials
   and then applied to each person's BTLT ratings. In two studies (total N
   = 352), participants who received higher, relative to lower, behavioral
   tendencies of success (BT-S) scores used approach-related coping
   strategies, pursued important goals, were capable of meeting their basic
   psychological needs, and reported higher levels of life satisfaction and
   flourishing. Individuals who received lower BT-S scores were prone to
   internalizing and externalizing problems and were deemed to be less
   skilled by peers. The research integrates bottom-up and top-down
   perspectives in emphasizing the verb-like nature of successful (versus
   unsuccessful) life functioning.},
DOI = {10.1080/17439760.2026.2714050},
EarlyAccessDate = {AUG 2026},
ISSN = {1743-9760},
EISSN = {1743-9779},
Unique-ID = {WOS:001842253400001},
}

@article{ WOS:001845659000001,
Author = {Pellegrino, Gerardo and Feraco, Tommaso and Meneghetti, Chiara and
   Carretti, Barbara},
Title = {Social, emotional, and behavioral skills as resources for student
   engagement: A one-year longitudinal study in high school students},
Journal = {LEARNING AND INDIVIDUAL DIFFERENCES},
Year = {2026},
Volume = {131},
Month = {OCT},
Abstract = {Social, emotional, and behavioral (SEB) skills refer to capacities that
   support social relationships, emotion regulation, and engagement with
   new experiences. These skills are considered crucial for high school
   students' academic success and well-being. The present study examined
   the longitudinal associations between five SEB skill domains
   (self-management, social engagement, cooperation, innovation, and
   emotional resilience) and four dimensions of student engagement
   (affective, behavioral, cognitive, and agentic). A sample of 1555
   Italian high school students completed self-report measures of SEB
   skills and engagement at the beginning (T1), middle (T2), and end (T3)
   of the academic year. Latent change score modelling showed that student
   engagement generally declined across the school year, particularly
   between T1 and T2. However, students with higher levels of
   selfmanagement, innovation, and social engagement at T1 showed smaller
   declines in engagement. Overall, these findings suggest that SEB skills
   help students sustain engagement, especially during the first part of
   the school year. Educational relevance statement: Social, emotional, and
   behavioral (SEB) skills are increasingly recognized as key competencies
   that foster student engagement in learning and academic activities.
   Using a comprehensive SEB framework and a three-wave longitudinal
   design, our study examined whether SEB skills contribute to the
   maintenance of engagement across the school year. Results indicated that
   students who reported higher levels of self-management, innovation, and
   social engagement also experienced smaller decreases in engagement,
   although the effects varied across engagement dimensions. Overall, these
   findings highlight the educational value of integrating SEB skills
   instruction into school curricula. Strengthening these skills may help
   students sustain engagement throughout the academic year, with potential
   benefits for academic achievement and wellbeing.},
DOI = {10.1016/j.lindif.2026.102988},
EarlyAccessDate = {AUG 2026},
Article-Number = {102988},
ISSN = {1041-6080},
EISSN = {1873-3425},
ResearcherID-Numbers = {Meneghetti, Chiara/D-1691-2014
   /L-6555-2013
   Feraco, Tommaso/AAE-7945-2021
   Pellegrino, Gerardo/KLC-9707-2024},
Unique-ID = {WOS:001845659000001},
}

@article{ WOS:001854644600001,
Author = {Yang, Guoliang and Wang, Zhihua and Fang, Miaoying and Wu, Weijiong and
   Wang, Ruiming},
Title = {Sense of purpose and perception of involution (Nei Juan): the
   role of actual-ideal self-discrepancy and future time perspective},
Journal = {FRONTIERS IN PSYCHOLOGY},
Year = {2026},
Volume = {17},
Month = {AUG 7},
Abstract = {Objective The concurrent increase in ``hollowed-heart{''} syndrome
   (which describes a state of purposelessness) and involution anxiety
   severely impairs the psychological development of contemporary Chinese
   undergraduates. From a de-involution perspective, this study aimed to
   examine the relationship between sense of purpose and perceived
   involution, and to explore the mediating role of actual-ideal
   self-discrepancy and the moderating effect of future time perspective in
   this association. Method A total of 747 Chinese undergraduates completed
   online and offline questionnaires measuring the four core psychological
   variables. Results (1) Sense of purpose exerted a significant negative
   direct effect (beta = -0.27, p < 0.001) on perceived involution; (2)
   Actual-ideal self-discrepancy partially mediated this negative
   relationship (indirect effect = -0.06, SE = 0.01, 95\% CI {[}-0.08,
   -0.03]); (3) Future time perspective moderated the first-stage path of
   the indirect effect. Simple slope analyses showed that the sense of
   purpose-perceived involution association was significant at a low (M -
   1SD) level of future time perspective (simple slope: beta = -0.24, p <
   0.001), but was not significant at a high (M + 1SD) level of future time
   perspective (simple slope: beta = -0.02, p > 0.05), such that the
   mediating role of actual-ideal self-discrepancy was weaker among
   individuals with a higher future time perspective. Conclusion A stronger
   sense of purpose mitigates undergraduates' perceived involution by
   reducing actual-ideal self-discrepancy. Cultivating life purpose and
   future-oriented cognition may help alleviate undergraduates' involution
   anxiety. Based on self-discrepancy theory and socioemotional selectivity
   theory, these findings clarify the underlying mechanism of the
   involution perception and have practical implications for college mental
   health education and targeted stress interventions.},
DOI = {10.3389/fpsyg.2026.1891243},
EarlyAccessDate = {AUG 2026},
Article-Number = {1891243},
ISSN = {1664-1078},
Unique-ID = {WOS:001854644600001},
}

@article{ WOS:001853497400009,
Author = {Hopwood, Christopher J.},
Title = {Assumptions and Consequences of Different Conceptualizations of
   Personality Functioning},
Journal = {PERSONALITY AND MENTAL HEALTH},
Year = {2026},
Volume = {20},
Number = {3},
Month = {AUG},
Abstract = {Personality functioning (PF) is the defining criterion for personality
   disorder in contemporary diagnosis and a popular topic in research.
   However, research and dialogue on PF has been uneven and often
   ideologically driven, in part because semantic differences are often
   conflated with substantive differences in the way PF is conceptualized.
   Here, I distinguish four ways to conceptualize PF: a psychodynamic
   developmental dimension, a descriptive summary of whatever all
   personality disorders or maladaptive traits have in common, a
   multidimensional model of traits, and a multidimensional model of
   adaptive capacities distinct from traits. I articulate the underlying
   assumptions and consequences for research and practice of each of these
   four approaches. I argue that conflating these assumptions has led to
   miscommunication about PF in the literature and describe how these
   models can be distinguished to provide more rigorous tests of the
   existence, nature, and utility of PF for personality theory and clinical
   assessment.},
DOI = {10.1002/pmh.70087},
Article-Number = {e70087},
ISSN = {1932-8621},
EISSN = {1932-863X},
Unique-ID = {WOS:001853497400009},
}
