	title = {Influence of invalidating childhood environment and emotion regulation on academic procrastination; [Influência do ambiente invalidante infantil e regulação emocional na procrastinação acadêmica]; [Influencia del ambiente invalidante infantil y regulación emocional en la procrastinación académica universitaria]},
