
@article{ WOS:001906045900001,
Author = {Lubczyk, Till and Bleidorn, Wiebke and Hopwood, Christopher J. and
   Kretzschmar, Andre},
Title = {Cognitive Abilities, Personality, and Sustainable Attitudes and Behavior},
Journal = {EUROPEAN JOURNAL OF PERSONALITY},
Year = {2026},
Month = {2026 OCT 19},
Abstract = {Climate change demands urgent action, yet individual engagement in
   sustainable behaviors remains inconsistent. We conducted two studies (N1
   = 280, N2 = 973) examining how political orientation, personality
   traits, reasoning ability, social-emotional-behavioral skills, and
   complex problem solving relate to sustainable attitudes and behaviors in
   U.S. adults. Using structural equation modeling, we found that openness
   to experience was the strongest predictor, alongside liberal political
   orientation and self-perceived social engagement and innovation skills.
   Unexpectedly, both cognitive personality traits showed negative
   associations with sustainability outcomes, challenging the notion that
   cognitive abilities universally facilitate adaptive behavior. For
   sustainable behavior, these associations were small to moderate (-.25 <=
   r <= -.15) and most pronounced for food-related and engagement-related
   behaviors. Specification curve analyses confirmed that less established
   constructs (social, emotional, and behavioral skill self-concepts and
   complex problem solving) contributed meaningful variance beyond
   established personality predictors and that these associations were
   robust across analytical specifications. Overall, psychological
   characteristics together explained up to 44\% of variance in sustainable
   attitudes and 29\% of variance in sustainable behavior. These findings
   advance our understanding of the psychological underpinnings of
   environmental engagement and highlight the need for future research to
   clarify the mechanisms underlying the negative cognitive
   ability-sustainability association.},
DOI = {10.1177/08902070261486523},
EarlyAccessDate = {OCT 2026},
ISSN = {0890-2070},
EISSN = {1099-0984},
Unique-ID = {WOS:001906045900001},
}

@article{ WOS:001906964500001,
Author = {Feraco, Tommaso and Jach, Hayley K. and Bardach, Lisa and Kopatz, Myriel
   and Murayama, Kou and Sewell, Madison N. and Napolitano, Christopher M.
   and Soto, Christopher J.},
Title = {Comparing change goals and feasibility beliefs about changing social,
   emotional, and behavioral skills vs. personality traits among
   adolescents, parents, and teachers},
Journal = {JOURNAL OF RESEARCH IN PERSONALITY},
Year = {2026},
Volume = {125},
Month = {DEC},
Abstract = {This study compared adolescents', parents', and teachers' change goals
   and feasibility beliefs for Big Five traits versus social, emotional,
   and behavioral (SEB) skills. Participants were 676 Italian high school
   students who reported about themselves, 461 parents who reported about
   their participating child, and 704 international teachers reporting
   about students in general. We found that all groups viewed SEB skills as
   more changeable than traits, with the strongest skill preference among
   teachers. Student differences were clearest for Social Engagement versus
   Extraversion. Teachers, but not parents, also reported greater interest
   in skill-based than trait-based interventions. These findings suggest
   that skill framing may increase perceived malleability and support for
   developmental interventions in educational contexts.},
DOI = {10.1016/j.jrp.2026.104777},
EarlyAccessDate = {OCT 2026},
Article-Number = {104777},
ISSN = {0092-6566},
EISSN = {1095-7251},
Unique-ID = {WOS:001906964500001},
}

@article{ WOS:001895196800001,
Author = {Wang, Faming and King, Ronnel B.},
Title = {Students and schools have distinct configurations of socio-emotional
   skills: a multilevel latent profile analysis},
Journal = {SOCIAL PSYCHOLOGY OF EDUCATION},
Year = {2026},
Volume = {29},
Number = {1},
Month = {OCT 6},
Abstract = {Socio-emotional skills have attracted increasing attention due to their
   significance to students' academic and well-being outcomes. However,
   there is ongoing debate in the literature over whether students'
   socio-emotional skills vary quantitatively or qualitatively.
   Furthermore, existing research on these skills has primarily considered
   socio-emotional skills as individual attributes of students, with less
   attention devoted to the possibility that schools could also have
   distinct socio-emotional profiles. To address these gaps, this study
   employed a multilevel latent profile analysis to investigate profiles of
   socio-emotional skills at both student and school levels from a
   person-centered perspective. We also examined how these socio-emotional
   profiles are associated with school climates and academic and well-being
   outcomes. This study included 29,755 15-year-old students from nine
   countries. At the student level, we identified four distinct profiles
   that differed more in average skill levels: Low, Average, Moderately
   High, and High Socio-emotional Profiles. We also identified two types of
   schools: Lower Socio-emotional Schools and Higher Socio-emotional
   Schools. Positive school climates, characterized by high levels of
   school belonging, cooperation, positive teacher-student relationships,
   and a lower frequency of bullying, were associated with more adaptive
   socio-emotional profiles. Concerningly, only a small proportion of
   students (5\%) and schools (28\%) showed adaptive socio-emotional
   skills. Our findings suggest the need to implement targeted
   interventions to foster socio-emotional skills tailored to the needs of
   different subgroups.},
DOI = {10.1007/s11218-026-10270-6},
Article-Number = {125},
ISSN = {1381-2890},
EISSN = {1573-1928},
ResearcherID-Numbers = {King, Ronnel/AGZ-0675-2022
   Wang, Faming/ADA-5335-2022},
Unique-ID = {WOS:001895196800001},
}

@article{ WOS:001894691200001,
Author = {Njoten, Hakon and Feyer, Frida K.},
Title = {From fragmentation to framework: defining core human competencies for
   higher education and the workplace},
Journal = {HIGHER EDUCATION SKILLS AND WORK-BASED LEARNING},
Year = {2026},
Month = {2026 OCT 5},
Abstract = {Purpose - This article addresses the lack of a coherent, shared language
   for human-centred competencies in higher education, introducing core
   human competencies (CHCs) and the 4S framework as an integrative
   alternative to fragmented terminology such as soft skills, transferable
   skills and 21st-century skills. Design/methodology/approach - A
   dual-strategy methodology was employed: a synthesis of leading
   international competency frameworks (CASEL, BESSI, CCR, OECD Learning
   Compass, 2030) combined with a structured bibliometric analysis of 880
   Scopus-indexed publications (2009-2025), using VOSviewer keyword
   co-occurrence mapping across seven identified clusters. Findings -
   Fifteen core competencies were identified from frameworks and research
   clusters. These are organised into the 4S framework: Self-awareness,
   Self-leadership, Situational management and Social capacities,
   positioning CHCs as a holistic framework. Research
   limitations/implications - The framework is conceptual and requires
   psychometric validation, longitudinal testing and cross-cultural
   assessment. Future research should examine predictive validity, factor
   structure and applicability across disciplines and cultural contexts.
   Practical implications - The 4S framework offers higher education
   institutions a shared conceptual language for curriculum design,
   learning outcomes, pedagogy, staff development and institutional
   strategy. Originality/value - This article provides the first
   empirically informed synthesis producing a unified taxonomy of CHCs
   applicable across higher education contexts, reducing terminological
   redundancy and offering a practically useable developmental
   architecture.},
DOI = {10.1108/HESWBL-03-2026-0201},
EarlyAccessDate = {OCT 2026},
ISSN = {2042-3896},
EISSN = {2042-390X},
Unique-ID = {WOS:001894691200001},
}

@article{ WOS:001886483600001,
Author = {Mason, Lucia and Carretti, Barbara},
Title = {Introduction to the special Issue-35th annual meeting of the Society for
   Text and Discourse},
Journal = {DISCOURSE PROCESSES},
Year = {2026},
Volume = {63},
Number = {6-7, SI},
Pages = {475-481},
Month = {AUG 9},
Abstract = {This special issue of Discourse Processes highlights work presented at
   the 35th annual meeting of The Society for Text \& Discourse (ST\&D)
   held in Padua, Italy in July 2025. The special issue opens with the
   thought-provoking contribution by Arthur Glenberg, the winner of the
   ST\&D Distinguished Scientific Contribution Award in 2025. The
   conference-based special collection then includes contributions
   regarding a range of relevant issues and challenges of research in four
   main areas: (1) reading, evaluating, and comprehending digital texts;
   (2) reading processes and outcomes; (3) spatial representations as tools
   for effective discourse processing and comprehension; and (4)
   discourse-based complex problem-solving. The contributions highlight
   that attention should be paid to the real context where cognitive
   processes are activated, the importance of motivational-emotional
   drivers while understanding written and oral discourse, and the use of
   up-to-date statistical procedures. The multidisciplinary and
   international character of our society is also well reflected in the
   contributions.},
DOI = {10.1080/0163853X.2026.2707631},
ISSN = {0163-853X},
EISSN = {1532-6950},
ResearcherID-Numbers = {Mason, Lucia/HZH-8252-2023
   /L-6555-2013},
Unique-ID = {WOS:001886483600001},
}

@article{ WOS:001907707400007,
Author = {Santos., Amanda Espagolla and Melo-Silva., Lucy Leal and Oliveira., Jose
   Egidio Barbosa},
Title = {What Drives Career Engagement? The Predictive Role of Socioemotional
   Skills and Career Adaptability},
Journal = {CANADIAN JOURNAL OF CAREER DEVELOPMENT},
Year = {2026},
Volume = {25},
Number = {2},
Pages = {164-175},
Abstract = {In contemporary labour markets characterized by uncertainty and rapid
   change, psychological resources that support proactive career behaviour
   are increasingly important. Drawing on Career Construction Theory, this
   study examined the relationships between socioemotional skills, career
   adaptability, and career engagement among university students.
   Participants were 204 interns who completed measures of socioemotional
   skills, career adaptability, and career engagement. Correlational
   analyses revealed positive associations among all major variables.
   Hierarchical regression showed that socioemotional skills significantly
   predicted career engagement after controlling for sociodemographic
   factors (Delta R \& sup2; = .31, p < .001). However, the inclusion of
   career adaptability substantially increased explained variance (Delta R
   \& sup2; = .26), with the final model accounting for 59.6\% of the
   variance in engagement. Concern (beta = .301, p < .001), Confidence
   (beta = .204, p = .018), and Curiosity (beta = .193, p = .030) emerged
   as the strongest predictors. These findings suggest that while
   socioemotional skills provide a foundational basis, career adaptability
   represents a more proximal predictor of proactive career behaviour. The
   study contributes to the literature by clarifying the complementary
   roles of these constructs in fostering career engagement among
   university students.},
DOI = {10.53379/cjcd.v25i2.3345},
ISSN = {1499-1845},
EISSN = {1499-1853},
Unique-ID = {WOS:001907707400007},
}
