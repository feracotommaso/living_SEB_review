	doi = {10.4018/979-8-3373-1042-8},
	url = {https://www.scopus.com/pages/publications/105050690359?origin=resultslist},
	abstract = {Description: Innovative strategies are reshaping how students learn and connect within academic environments. As schools and universities face increasing pressures, educators are turning to creative approaches that support both emotional resilience and motivation. By integrating practices such as personalized learning pathways, collaborative spaces, and engagement tools, institutions can cultivate environments where students feel empowered and inspired. These emerging strategies not only enhance academic performance but also promote development, preparing learners for success in an increasingly complex world. Innovative Strategies for Well-Being and Motivation in Education explores the integration of educational psychology and tools to help educators engage with their students. This book examines a holistic approach in creating learning environments that are not only effective but also promote the well-being and motivation of students and teachers. Covering topics such as innovative strategies, educational psychology, and student engagement, this book is an excellent resource for researchers, educators, graduate students, and educational institutions. Coverage: The many academic areas covered in this publication include, but are not limited to: Academic Success Cognitive Harmony Effective Communications Inclusive Learning Innovative Education Pedagogical Innovations School Engagement Student Engagement Student Perspectives Student Well-being Teacher Discourse Teacher Education. © 2027 by IGI Global Scientific Publishing. All rights reserved.},
	type = {Book},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Efthymiou2026471,
	author = {Efthymiou, Iris-Panagiota},
	title = {Emotional Intelligence Meets Artificial Intelligence: Redefining Human-Machine Interactions},
	year = {2026},
	journal = {Encyclopedia of Modern Artificial Intelligence},
	pages = {471 - 491},
	doi = {10.4018/979-8-3693-5638-8.ch021},
	url = {https://www.scopus.com/pages/publications/105050691623?origin=resultslist},
	abstract = {The convergence of emotional intelligence (EI) and artificial intelligence (AI) is transforming humanmachine interactions by integrating empathy, context, and adaptability into technology. This chapter explores how embedding EI into AI systems enhances their ability to detect, interpret, and respond to human emotions, improving experiences in healthcare, education, and customer service. It examines the benefits of emotionally intelligent AI, such as personalized interactions and stronger trust, alongside challenges like bias, privacy concerns, and the complexity of human emotions. Ethical considerations are addressed, emphasizing transparency, consent, and accountability. By fostering emotionally attuned AI, we move towards a future where machines act not merely as tools but as empathetic collaborators, reshaping industries and advancing human-centred innovation. © 2027 by IGI Global Scientific Publishing. All rights reserved.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Caurin2025,
	author = {Caurin, Nathália Bonugli and da Rocha, Rafael Moreton Alves and Hauck-Filho, Nelson},
	title = {Pathological Narcissism Examined from the Perspective of the Big Five Socioemotional Factors; [O narcisismo patológico visto a partir dos cinco grandes fatores socioemocionais]; [Narcisismo patológico examinado desde la perspectiva de los cinco grandes factores socioemocionales]},
	year = {2025},
	journal = {Estudos de Psicologia (Natal)},
	volume = {30},
	pages = {},
	doi = {10.22491/1678-4669.20250003},
	url = {https://www.scopus.com/pages/publications/105048781723?origin=resultslist},
	abstract = {Pathological narcissism is composed of two major dimensions: vulnerability and grandiosity; however, little is known, so far, about the specific socio-emotional impairments of these traits. Our objective was to map each component of narcissism onto the factors and facets of the socio-emotional Big Five model. Correlational and latent class analyses were performed in a sample of 662 Brazilian adults (M=35.43 years, SD±12.09; 80.97% women). Correlations pointed to socio-emotional impairment in all components of narcissism. The analysis of latent profiles revealed six classes of narcissism ordered according to the level of severity of socioemotional impairment, and no separate profiles were found between the dimensions. The findings have theoretical and clinical implications, allowing us to understand the deficient socioemotional skills in pathological narcissism. © 2025, Universidade Federal do Rio Grande do Norte. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Fischer20261,
	author = {Fischer, Olga and Akita, Kimi and Perniss, Pamela},
	title = {The Oxford Handbook of Iconicity in Language},
	year = {2026},
	journal = {The Oxford Handbook of Iconicity in Language},
	pages = {1 - 1043},
	doi = {10.1093/oxfordhb/9780192849489.001.0001},
	url = {https://www.scopus.com/pages/publications/105048783804?origin=resultslist},
	abstract = {The Oxford Handbook of Iconicity in Language offers a comprehensive collection of chapters that address the presence and role of iconicity—the perceived resemblance between form and meaning—in language. The content covers iconicity in all modes of language (spoken, written, and signed), on all levels of language (from phonology and morphology to syntax and discourse), and in all aspects of language (language structure, language learning, language processing, and language evolution and change). Far from being a minor occurrence unique to onomatopoeia, such as meow and clang, the Handbook makes clear that iconicity resides in every aspect of the synchrony and diachrony of language. The publication of the Handbook converges with a renewed academic interest in iconicity. In their breadth and scope, the chapters reflect this history and trajectory of interest in iconicity, moving from Charles Sanders Peirce’s semiotics to the recognition of iconicity as a general, and central, property or design feature of language that may facilitate its processing, acquisition, and evolution. The Handbook is a must-read for students and researchers in all areas of the language sciences, including linguistics, philosophy, psychology, anthropology, and cognitive science, who are interested in why language is structured the way it is. © editorial matter and organization Olga Fischer, Kimi Akita, and Pamela Perniss 2026 © the chapters their several authors 2026.},
	type = {Book},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Engelbrecht-Aldworth2026,
	author = {Engelbrecht-Aldworth, Erika and Toendepi, Joyce},
	title = {Understanding educators’ spiritual awareness and well-being in selected South African secondary schools},
	year = {2026},
	journal = {Journal of Beliefs and Values},
	pages = {},
	doi = {10.1080/13617672.2026.2715657},
	url = {https://www.scopus.com/pages/publications/105049196780?origin=resultslist},
	abstract = {The South African education system is characterised by overwhelming workloads, limited resources, fear of violence, and a lack of opportunities for advancement. Work is no longer just about completing tasks; it also encompasses personal fulfilment, social interaction, and building connections with others. Spirituality offers individuals a profound sense of self-worth, fosters deep connections with themselves and others, and empowers them to influence the world through meaningful actions. The objective of this study was to understand the lived experience of spiritual awareness and well-being of educators in selected secondary schools in South Africa. A qualitative interpretivist approach was adopted, involving interviews with 12 secondary school educators who were purposefully sampled. Semi-structured interviews were conducted, and the data was analysed thematically. Participants reported feelings of professional depersonalisation, burnout, and exhaustion, but found solace in their spirituality. The findings revealed that spiritual awareness enhances well-being and self-efficacy, boosting educators’ motivation to support learners. Additionally, spiritual coping helps educators remain focused. The findings highlight the need to prioritise the well-being of secondary school educators in South Africa by integrating spiritual aspects into education, thereby improving cognitive abilities, emotional health, and connectedness with oneself and a higher power. © 2026 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Olekalns2026663,
	author = {Olekalns, Mara},
	title = {LOST IN TRANSLATION: WHERE IS THE RELATIONAL CONTEXT IN NEGOTIATION RESEARCH?},
	year = {2026},
	journal = {Academy of Management Annals},
	volume = {20},
	number = {2},
	pages = {663 - 698},
	doi = {10.5465/ANNALS.2024.0055},
	url = {https://www.scopus.com/pages/publications/105049125387?origin=resultslist},
	abstract = {Economic and psychological paradigms conceptualize negotiations as time-bounded events set apart from our organizational relationships. These paradigms yield a deep understanding of how negotiators can maximize their dealmaking effectiveness. They also constrain our understanding by abstracting negotiations from the ongoing relationships within which they are embedded. Deeper insight into negotiation dynamics requires a broader view, one that locates negotiations within their relational context. By distilling constructs from disciplines that offer this broader perspective, I identify three insights that expand our conceptualization of negotiation. First, the interaction between broad relationship and domain-specific negotiation narratives shapes how individuals approach negotiations and how they craft settlements. Second, embedding negotiations within a relationship trajectory highlights a recursive dynamic: relationship quality determines at-the-table tactics, and this experience spills over to transform the ongoing relationship. Third, relational tone—the what and how of interpersonal interactions— resets the between-negotiation relationship trajectory. This maintenance work establishes relationship expectations and facilitates (or impedes) convergence to shared narratives, becoming a critical input into subsequent negotiations. In conclusion, I discuss the unifying constructs that broaden negotiation theory, identify the pedagogical implications of a relational perspective, and outline the methodological expansion needed to benefit fromthese insights. © Academy of Management Annals},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

